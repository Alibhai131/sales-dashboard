<% 
    var activePage = 'employees'; 
    var pageTitle = 'Employees';
    var title = 'Employees - Sales Dashboard';
    var empCount = typeof employees !== 'undefined' ? employees.length : 0;
    var empProgress = Math.min((empCount / 10) * 100, 100);
%>

<div class="page-header-row">
    <div>
        <p class="page-description">Manage your employees and track their sales performance (Max 10)</p>
    </div>
    <button class="btn btn-primary" id="addEmployeeBtn" 
        <%= empCount >= 10 ? 'disabled' : '' %>>
        <i class="fas fa-plus"></i> Add Employee
        <% if (empCount >= 10) { %>
            <span class="btn-tooltip">Maximum 10 employees reached</span>
        <% } %>
    </button>
</div>

<!-- Employee Count -->
<div class="employee-count-bar">
    <span>Employees: <strong><%= empCount %> / 10</strong></span>
    <div class="progress-bar">
        <div class="progress-fill" id="empProgressFill" data-progress="<%= empProgress %>"></div>
    </div>
</div>

<!-- Employee Cards Grid -->
<div class="employee-grid">
    <% if (typeof employees !== 'undefined' && employees.length > 0) { %>
        <% employees.forEach(function(emp) { %>
            <div class="employee-card">
                <div class="emp-card-header">
                    <div class="emp-avatar">
                        <div class="avatar-placeholder">
                            <%= emp.name.charAt(0).toUpperCase() %>
                        </div>
                    </div>
                    <div class="emp-actions">
                        <button class="icon-btn small" onclick="editEmployee('<%= emp._id %>')" title="Edit">
                            <i class="fas fa-edit"></i>
                        </button>
                        <button class="icon-btn small text-danger" onclick="deleteEmployee('<%= emp._id %>', '<%= emp.name %>')" title="Delete">
                            <i class="fas fa-trash"></i>
                        </button>
                    </div>
                </div>
                <div class="emp-info">
                    <h3><%= emp.name %></h3>
                    <span class="emp-role"><%= emp.role || 'Sales Associate' %></span>
                </div>
                <div class="emp-stats">
                    <div class="emp-stat">
                        <span class="emp-stat-value"><%= emp.totalSales || 0 %></span>
                        <span class="emp-stat-label">Sales</span>
                    </div>
                    <div class="emp-stat">
                        <span class="emp-stat-value">
                            <%= typeof currencySymbol !== 'undefined' ? currencySymbol : '$' %><%= emp.totalRevenue ? emp.totalRevenue.toLocaleString() : '0' %>
                        </span>
                        <span class="emp-stat-label">Revenue</span>
                    </div>
                    <div class="emp-stat">
                        <span class="emp-stat-value">
                            <%= typeof currencySymbol !== 'undefined' ? currencySymbol : '$' %><%= emp.totalProfit ? emp.totalProfit.toLocaleString() : '0' %>
                        </span>
                        <span class="emp-stat-label">Profit</span>
                    </div>
                </div>
                <div class="emp-monthly">
                    <span>This Month: <strong><%= emp.monthlySales || 0 %> sales</strong></span>
                </div>
            </div>
        <% }); %>
    <% } else { %>
        <div class="empty-state-full">
            <i class="fas fa-user-plus"></i>
            <h3>No Employees Added</h3>
            <p>Add your first employee to start tracking their sales</p>
            <button class="btn btn-primary" id="addFirstEmployee">
                <i class="fas fa-plus"></i> Add Employee
            </button>
        </div>
    <% } %>
</div>

<!-- Add/Edit Employee Modal -->
<div class="modal" id="employeeModal">
    <div class="modal-content">
        <div class="modal-header">
            <h2 id="employeeModalTitle">Add Employee</h2>
            <button class="modal-close" onclick="closeEmployeeModal()">&times;</button>
        </div>
        <div class="modal-body">
            <form id="employeeForm">
                <input type="hidden" id="employeeId" name="employeeId">
                <div class="form-group">
                    <label for="empName">Name</label>
                    <input type="text" id="empName" name="name" placeholder="Enter employee name" required>
                </div>
                <div class="form-group">
                    <label for="empRole">Role / Position</label>
                    <input type="text" id="empRole" name="role" placeholder="e.g., Sales Associate, Cashier">
                </div>
                <div class="form-group">
                    <label for="empPhone">Phone (Optional)</label>
                    <input type="tel" id="empPhone" name="phone" placeholder="Phone number">
                </div>
                <div class="form-actions">
                    <button type="button" class="btn btn-outline" onclick="closeEmployeeModal()">Cancel</button>
                    <button type="submit" class="btn btn-primary" id="saveEmployeeBtn">Save Employee</button>
                </div>
            </form>
        </div>
    </div>
</div>

<script>
    document.addEventListener('DOMContentLoaded', function() {
        // Apply progress bar width cleanly via JS to avoid CSS linter issues
        const progressFill = document.getElementById('empProgressFill');
        if (progressFill && progressFill.dataset.progress) {
            progressFill.style.width = progressFill.dataset.progress + '%';
        }

        const addBtn = document.getElementById('addEmployeeBtn');
        const addFirstBtn = document.getElementById('addFirstEmployee');
        
        if (addBtn) addBtn.addEventListener('click', () => openEmployeeModal());
        if (addFirstBtn) addFirstBtn.addEventListener('click', () => openEmployeeModal());

        const empForm = document.getElementById('employeeForm');
        if (empForm) {
            empForm.addEventListener('submit', async function(e) {
                e.preventDefault();
                const formData = new FormData(this);
                const data = Object.fromEntries(formData);
                const id = data.employeeId;
                delete data.employeeId;
                
                const url = id ? `/api/employees/${id}` : '/api/employees';
                const method = id ? 'PUT' : 'POST';
                
                try {
                    const res = await fetch(url, {
                        method,
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify(data)
                    });
                    const result = await res.json();
                    if (result.success) {
                        showToast(id ? 'Employee updated!' : 'Employee added!', 'success');
                        setTimeout(() => location.reload(), 1000);
                    } else {
                        showToast(result.message || 'Error saving employee', 'error');
                    }
                } catch(err) {
                    showToast('Failed to save employee', 'error');
                }
            });
        }
    });

    function openEmployeeModal(employee = null) {
        const modal = document.getElementById('employeeModal');
        const title = document.getElementById('employeeModalTitle');
        const form = document.getElementById('employeeForm');
        
        if (employee) {
            title.textContent = 'Edit Employee';
            document.getElementById('employeeId').value = employee._id;
            document.getElementById('empName').value = employee.name;
            document.getElementById('empRole').value = employee.role || '';
            document.getElementById('empPhone').value = employee.phone || '';
        } else {
            title.textContent = 'Add Employee';
            form.reset();
            document.getElementById('employeeId').value = '';
        }
        modal.classList.add('active');
    }

    function closeEmployeeModal() {
        document.getElementById('employeeModal').classList.remove('active');
    }

    async function editEmployee(id) {
        try {
            const res = await fetch(`/api/employees/${id}`);
            const data = await res.json();
            if (data.success) {
                openEmployeeModal(data.employee);
            }
        } catch(err) {
            showToast('Error loading employee', 'error');
        }
    }

    async function deleteEmployee(id, name) {
        if (!confirm(`Are you sure you want to delete "${name}"? This action cannot be undone.`)) return;
        try {
            const res = await fetch(`/api/employees/${id}`, { method: 'DELETE' });
            const result = await res.json();
            if (result.success) {
                showToast('Employee deleted', 'success');
                setTimeout(() => location.reload(), 1000);
            } else {
                showToast(result.message || 'Error deleting employee', 'error');
            }
        } catch(err) {
            showToast('Failed to delete employee', 'error');
        }
    }
</script>