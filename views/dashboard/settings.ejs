<% 
    var activePage = 'settings'; 
    var pageTitle = 'Settings';
    var title = 'Settings - Sales Dashboard';
%>

<div class="settings-layout">
    <!-- Settings Tabs (Left Column) -->
    <div class="settings-tabs">
        <button class="settings-tab active" data-tab="profile">
            <i class="fas fa-user"></i> <span>Profile</span>
        </button>
        <button class="settings-tab" data-tab="business">
            <i class="fas fa-store"></i> <span>Business</span>
        </button>
        <button class="settings-tab" data-tab="currency">
            <i class="fas fa-coins"></i> <span>Currency</span>
        </button>
        <button class="settings-tab" data-tab="notifications">
            <i class="fas fa-bell"></i> <span>Notifications</span>
        </button>
        <button class="settings-tab" data-tab="security">
            <i class="fas fa-shield-alt"></i> <span>Security</span>
        </button>
        <% if (typeof user !== 'undefined' && user.role === 'superadmin') { %>
        <button class="settings-tab" data-tab="subscription">
            <i class="fas fa-crown"></i> <span>Subscription</span>
        </button>
        <% } %>
    </div>

    <!-- Settings Content (Right Column) -->
    <div class="settings-content">

        <!-- Profile Panel -->
        <div class="settings-panel active" id="panel-profile">
            <div class="card">
                <div class="card-header">
                    <h2>Profile Settings</h2>
                </div>
                <div style="padding: 2rem;">
                    <form action="/settings/profile" method="POST">
                        <div class="avatar-upload">
                            <div class="avatar-preview">
                                <div class="avatar-placeholder large">
                                    <%= typeof user !== 'undefined' && user.name ? user.name.charAt(0).toUpperCase() : 'U' %>
                                </div>
                            </div>
                            <div>
                                <button type="button" class="btn btn-outline" disabled>
                                    <i class="fas fa-camera"></i> Change Photo
                                </button>
                            </div>
                        </div>
                        
                        <div class="form-row">
                            <div class="form-group">
                                <label>Full Name</label>
                                <input type="text" name="name" value="<%= typeof user !== 'undefined' ? user.name : '' %>" required>
                            </div>
                            <div class="form-group">
                                <label>Email Address</label>
                                <input type="email" name="email" value="<%= typeof user !== 'undefined' ? user.email : '' %>" required>
                            </div>
                        </div>
                        
                        <div class="form-group">
                            <label>Phone Number</label>
                            <input type="tel" name="phone" value="<%= typeof user !== 'undefined' && user.phone ? user.phone : '' %>" placeholder="+92 300 1234567">
                        </div>
                        
                        <button type="submit" class="btn btn-primary">
                            <i class="fas fa-save"></i> Save Changes
                        </button>
                    </form>
                </div>
            </div>
        </div>

        <!-- Business Panel -->
        <div class="settings-panel" id="panel-business">
            <div class="card">
                <div class="card-header">
                    <h2>Business Settings</h2>
                </div>
                <div style="padding: 2rem;">
                    <form action="/settings/business" method="POST">
                        <div class="form-group">
                            <label>Business / Shop Name</label>
                            <input type="text" name="shopName" value="<%= typeof user !== 'undefined' && user.shopName ? user.shopName : '' %>" placeholder="e.g. Mian Ji Electronics">
                        </div>
                        <div class="form-group">
                            <label>Business Address</label>
                            <textarea name="address" rows="3" placeholder="Enter shop address"><%= typeof user !== 'undefined' && user.address ? user.address : '' %></textarea>
                        </div>
                        <div class="form-group">
                            <label>Business Type</label>
                            <select name="businessType" class="form-select">
                                <option value="retail" <%= typeof user !== 'undefined' && user.businessType === 'retail' ? 'selected' : '' %>>Retail Shop</option>
                                <option value="wholesale" <%= typeof user !== 'undefined' && user.businessType === 'wholesale' ? 'selected' : '' %>>Wholesale Business</option>
                                <option value="ecommerce" <%= typeof user !== 'undefined' && user.businessType === 'ecommerce' ? 'selected' : '' %>>E-Commerce Store</option>
                            </select>
                        </div>
                        <button type="submit" class="btn btn-primary">
                            <i class="fas fa-save"></i> Save Business Info
                        </button>
                    </form>
                </div>
            </div>
        </div>

        <!-- Currency Panel -->
        <div class="settings-panel" id="panel-currency">
            <div class="card">
                <div class="card-header">
                    <h2>Currency Settings</h2>
                </div>
                <div style="padding: 2rem;">
                    <form action="/settings/currency" method="POST">
                        <div class="form-group">
                            <label>Preferred Currency</label>
                            <select name="currency" class="form-select">
                                <option value="USD" <%= (typeof selectedCurrency !== 'undefined' && selectedCurrency === 'USD') ? 'selected' : '' %>>$ USD - US Dollar</option>
                                <option value="GBP" <%= (typeof selectedCurrency !== 'undefined' && selectedCurrency === 'GBP') ? 'selected' : '' %>>£ GBP - British Pound</option>
                                <option value="PKR" <%= (typeof selectedCurrency !== 'undefined' && selectedCurrency === 'PKR') ? 'selected' : '' %>>Rs PKR - Pakistani Rupee</option>
                                <option value="INR" <%= (typeof selectedCurrency !== 'undefined' && selectedCurrency === 'INR') ? 'selected' : '' %>>₹ INR - Indian Rupee</option>
                                <option value="EUR" <%= (typeof selectedCurrency !== 'undefined' && selectedCurrency === 'EUR') ? 'selected' : '' %>>€ EUR - Euro</option>
                                <option value="AED" <%= (typeof selectedCurrency !== 'undefined' && selectedCurrency === 'AED') ? 'selected' : '' %>>د.إ AED - UAE Dirham</option>
                            </select>
                        </div>
                        <button type="submit" class="btn btn-primary">
                            <i class="fas fa-save"></i> Save Currency
                        </button>
                    </form>
                </div>
            </div>
        </div>

        <!-- Notifications Panel -->
        <div class="settings-panel" id="panel-notifications">
            <div class="card">
                <div class="card-header">
                    <h2>Notification Preferences</h2>
                </div>
                <div style="padding: 2rem;">
                    <div class="toggle-setting">
                        <div>
                            <h4>New Sale Alerts</h4>
                            <p class="text-muted">Receive pop-up notifications when a new sale is made</p>
                        </div>
                        <label class="toggle-switch">
                            <input type="checkbox" checked>
                            <span class="toggle-slider"></span>
                        </label>
                    </div>
                    <div class="toggle-setting">
                        <div>
                            <h4>Low Stock Alerts</h4>
                            <p class="text-muted">Get notified when product stock drops below 5 items</p>
                        </div>
                        <label class="toggle-switch">
                            <input type="checkbox" checked>
                            <span class="toggle-slider"></span>
                        </label>
                    </div>
                </div>
            </div>
        </div>

        <!-- Security Panel -->
        <div class="settings-panel" id="panel-security">
            <div class="card">
                <div class="card-header">
                    <h2>Change Password</h2>
                </div>
                <div style="padding: 2rem;">
                    <form action="/settings/password" method="POST">
                        <div class="form-group">
                            <label>Current Password</label>
                            <input type="password" name="currentPassword" required placeholder="••••••••">
                        </div>
                        <div class="form-group">
                            <label>New Password</label>
                            <input type="password" name="newPassword" required minlength="6" placeholder="••••••••">
                        </div>
                        <div class="form-group">
                            <label>Confirm New Password</label>
                            <input type="password" name="confirmPassword" required placeholder="••••••••">
                        </div>
                        <button type="submit" class="btn btn-primary">
                            <i class="fas fa-lock"></i> Update Password
                        </button>
                    </form>
                </div>
            </div>
        </div>

        <!-- Subscription Panel -->
        <% if (typeof user !== 'undefined' && user.role === 'superadmin') { %>
        <div class="settings-panel" id="panel-subscription">
            <div class="card">
                <div class="card-header">
                    <h2>Subscription Status</h2>
                </div>
                <div style="padding: 2rem;">
                    <div class="sub-status active">
                        <i class="fas fa-check-circle"></i>
                        <span>Super Admin - Lifetime Plan</span>
                    </div>
                    <p class="text-muted">You have full access to manage all buyers, sub-admins, and analytics.</p>
                </div>
            </div>
        </div>
        <% } %>

    </div>
</div>

<script>
    document.querySelectorAll('.settings-tab').forEach(tab => {
        tab.addEventListener('click', function() {
            document.querySelectorAll('.settings-tab').forEach(t => t.classList.remove('active'));
            document.querySelectorAll('.settings-panel').forEach(p => p.classList.remove('active'));
            this.classList.add('active');
            const panel = document.getElementById('panel-' + this.dataset.tab);
            if (panel) panel.classList.add('active');
        });
    });
</script>