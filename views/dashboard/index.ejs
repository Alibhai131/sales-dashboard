<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Dashboard - Sales Dashboard</title>
    <link rel="stylesheet" href="/css/style.css">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" rel="stylesheet">
    <style>
        .quick-sale-card {
            background: var(--color-white);
            padding: 1.5rem;
            border-radius: var(--card-border-radius);
            box-shadow: var(--box-shadow);
            margin-top: 1.5rem;
        }
        .quick-sale-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
            gap: 1rem;
            margin-top: 1rem;
            align-items: end;
        }
        .timeframe-select {
            padding: 0.5rem 1rem;
            border-radius: var(--border-radius-1);
            background: var(--color-light);
            color: var(--color-dark);
            border: none;
            font-weight: 600;
            cursor: pointer;
        }
    </style>
</head>
<body>
    <div class="container">
        <!-- SIDEBAR -->
        <aside id="aside-bar">
            <div class="top">
                <div class="logo">
                    <i class="fa-solid fa-chart-line primary" style="font-size: 1.6rem;"></i>
                    <h2>SALES<span class="danger">PRO</span></h2>
                </div>
                <div class="close" id="close-btn"><i class="fa-solid fa-xmark"></i></div>
            </div>

            <div class="sidebar">
                <a href="/dashboard" class="active"><i class="fa-solid fa-grid-2"></i><h3>Dashboard</h3></a>
                <a href="/employees"><i class="fa-solid fa-users"></i><h3>Workers (<%= employeeCount || 0 %>/10)</h3></a>
                <a href="/products"><i class="fa-solid fa-box-open"></i><h3>Products</h3></a>
                <a href="/reports"><i class="fa-solid fa-file-invoice"></i><h3>PDF Reports</h3></a>
                
                <% if(user.role === 'superadmin' || user.role === 'subadmin') { %>
                    <a href="/admin/buyers" style="color: var(--color-danger);"><i class="fa-solid fa-user-shield"></i><h3>Admin Panel</h3></a>
                <% } %>
                
                <a href="/auth/logout"><i class="fa-solid fa-right-from-bracket"></i><h3>Logout</h3></a>
            </div>
        </aside>

        <!-- MAIN DASHBOARD -->
        <main>
            <div style="display: flex; justify-content: space-between; align-items: center;">
                <h1>Dashboard</h1>
                <!-- TIMEFRAME FILTER -->
                <form action="/dashboard" method="GET" id="filterForm">
                    <select name="timeframe" class="timeframe-select" onchange="document.getElementById('filterForm').submit()">
                        <option value="today" <%= timeframe === 'today' ? 'selected' : '' %>>Today (24h)</option>
                        <option value="week" <%= timeframe === 'week' ? 'selected' : '' %>>This Week</option>
                        <option value="month" <%= timeframe === 'month' ? 'selected' : '' %>>This Month</option>
                        <option value="year" <%= timeframe === 'year' ? 'selected' : '' %>>This Year</option>
                        <option value="all" <%= timeframe === 'all' ? 'selected' : '' %>>All Time</option>
                    </select>
                </form>
            </div>

            <% if (user.isReadOnly) { %>
                <div style="background: var(--color-danger); color: white; padding: 12px; border-radius: 8px; margin-top: 10px; font-weight: bold;">
                    <i class="fa-solid fa-lock"></i> Subscription Unpaid/Blocked. Read-Only Mode Active.
                </div>
            <% } %>

            <!-- 3 TOP INSIGHT CARDS -->
            <div class="insights">
                <!-- TOTAL SALES -->
                <div class="sales">
                    <i class="fa-solid fa-chart-simple"></i>
                    <div class="middle">
                        <div class="left">
                            <h3>Total Sales</h3>
                            <h1><%= user.currency %> <%= totalSales.toLocaleString() %></h1>
                        </div>
                        <div class="progress">
                            <svg><circle cx="38" cy="38" r="36"></circle></svg>
                            <div class="number"><p>100%</p></div>
                        </div>
                    </div>
                    <small class="text-muted"><%= timeframe.toUpperCase() %> summary</small>
                </div>

                <!-- TOTAL INVESTMENT / COST -->
                <div class="expenses">
                    <i class="fa-solid fa-bag-shopping"></i>
                    <div class="middle">
                        <div class="left">
                            <h3>Investment (Cost)</h3>
                            <h1><%= user.currency %> <%= totalInvestment.toLocaleString() %></h1>
                        </div>
                        <div class="progress">
                            <svg><circle cx="38" cy="38" r="36"></circle></svg>
                            <div class="number"><p><%= totalSales > 0 ? Math.round((totalInvestment/totalSales)*100) : 0 %>%</p></div>
                        </div>
                    </div>
                    <small class="text-muted">Buying cost total</small>
                </div>

                <!-- PROFIT & ROI -->
                <div class="income">
                    <i class="fa-solid fa-arrow-trend-up"></i>
                    <div class="middle">
                        <div class="left">
                            <h3>Profit (ROI: <%= avgROI %>%)</h3>
                            <h1><%= user.currency %> <%= totalProfit.toLocaleString() %></h1>
                        </div>
                        <div class="progress">
                            <svg><circle cx="38" cy="38" r="36"></circle></svg>
                            <div class="number"><p><%= avgROI %>%</p></div>
                        </div>
                    </div>
                    <small class="text-muted">Net profit calculation</small>
                </div>
            </div>

            <!-- QUICK RECORD NEW SALE -->
            <% if (!user.isReadOnly) { %>
            <div class="quick-sale-card">
                <h2><i class="fa-solid fa-cart-plus primary"></i> Record New Sale</h2>
                <form action="/sales/add" method="POST" class="quick-sale-grid">
                    <div>
                        <label>Select Product</label>
                        <select name="productId" required style="width:100%; padding:0.7rem; border-radius: 8px; background: var(--color-light); border:none;">
                            <% if(products && products.length > 0) { %>
                                <% products.forEach(p => { %>
                                    <option value="<%= p._id %>"><%= p.productName %> - Cost: <%= user.currency %><%= p.costPrice %> | Sell: <%= user.currency %><%= p.sellingPrice %></option>
                                <% }) %>
                            <% } else { %>
                                <option value="">No Products - Add in Products tab</option>
                            <% } %>
                        </select>
                    </div>
                    <div>
                        <label>Worker / Employee</label>
                        <select name="employeeId" style="width:100%; padding:0.7rem; border-radius: 8px; background: var(--color-light); border:none;">
                            <option value="">-- Store Direct --</option>
                            <% if(typeof employees !== 'undefined' && employees.length > 0) { %>
                                <% employees.forEach(e => { %>
                                    <option value="<%= e._id %>"><%= e.name %> (<%= e.roleTitle %>)</option>
                                <% }) %>
                            <% } %>
                        </select>
                    </div>
                    <div>
                        <label>Quantity</label>
                        <input type="number" name="quantity" value="1" min="1" required style="width:100%; padding:0.7rem; border-radius: 8px; background: var(--color-light); border:none;">
                    </div>
                    <div>
                        <label>Sale Source</label>
                        <select name="source" style="width:100%; padding:0.7rem; border-radius: 8px; background: var(--color-light); border:none;">
                            <option value="local">Local Shop</option>
                            <option value="ecommerce">E-Commerce</option>
                        </select>
                    </div>
                    <div>
                        <button type="submit" style="width:100%; padding:0.75rem; background: var(--color-primary); color:white; border-radius: 8px; font-weight:bold; cursor:pointer;">Save Sale</button>
                    </div>
                </form>
            </div>
            <% } %>

            <!-- RECENT ORDERS TABLE -->
            <div class="recent-orders">
                <h2>Recent Sales Transactions</h2>
                <table>
                    <thead>
                        <tr>
                            <th>Product</th>
                            <th>Cost</th>
                            <th>Sold For</th>
                            <th>Profit</th>
                            <th>ROI %</th>
                            <th>Status</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% if(recentSales && recentSales.length > 0) { %>
                            <% recentSales.forEach(sale => { %>
                                <tr>
                                    <td><b><%= sale.productName %></b> (x<%= sale.quantity %>)</td>
                                    <td><%= user.currency %> <%= sale.totalInvestment %></td>
                                    <td><%= user.currency %> <%= sale.totalSales %></td>
                                    <td class="success">+<%= user.currency %> <%= sale.profit %></td>
                                    <td><b><%= sale.roiPercentage %>%</b></td>
                                    <td class="<%= sale.paymentStatus === 'Paid' ? 'success' : 'warning' %>"><%= sale.paymentStatus %></td>
                                </tr>
                            <% }) %>
                        <% } else { %>
                            <tr><td colspan="6">No sales recorded for <%= timeframe %>.</td></tr>
                        <% } %>
                    </tbody>
                </table>
            </div>
        </main>

        <!-- RIGHT PANEL -->
        <div class="right">
            <div class="top">
                <button id="menu-btn"><i class="fa-solid fa-bars"></i></button>
                <div class="profile">
                    <div class="info">
                        <p>Hey, <b><%= user.name %></b></p>
                        <small class="text-muted"><%= user.role.toUpperCase() %></small>
                    </div>
                </div>
            </div>

            <!-- RECENT UPDATES -->
            <div class="recent-updates">
                <h2>System Alerts</h2>
                <div class="updates">
                    <div class="update">
                        <i class="fa-solid fa-circle-check success" style="font-size: 1.8rem;"></i>
                        <div class="message">
                            <p><b>Multi-Currency Active</b> (<%= user.currency %>)</p>
                            <small class="text-muted">System ready</small>
                        </div>
                    </div>
                    <div class="update">
                        <i class="fa-solid fa-users primary" style="font-size: 1.8rem;"></i>
                        <div class="message">
                            <p><b>Worker Data Limit</b></p>
                            <small class="text-muted">Max 10 workers allowed</small>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <script>
        const sideMenu = document.querySelector("#aside-bar");
        const menuBtn = document.querySelector("#menu-btn");
        const closeBtn = document.querySelector("#close-btn");
        if(menuBtn) menuBtn.addEventListener('click', () => sideMenu.classList.add('show-sidebar'));
        if(closeBtn) closeBtn.addEventListener('click', () => sideMenu.classList.remove('show-sidebar'));
    </script>
</body>
</html>