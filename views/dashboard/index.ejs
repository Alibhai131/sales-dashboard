<% 
    var activePage = 'dashboard'; 
    var pageTitle = 'Dashboard';
    var title = 'Dashboard - Sales Dashboard';
    var periodText = typeof periodLabel !== 'undefined' ? periodLabel : 'Today';
%>

<!-- Date Filter Row -->
<div class="dashboard-filter-row">
    <div class="filter-tabs">
        <a href="/dashboard?period=today" class="filter-tab <%= typeof currentPeriod !== 'undefined' && currentPeriod === 'today' ? 'active' : '' %>">Today</a>
        <a href="/dashboard?period=week" class="filter-tab <%= typeof currentPeriod !== 'undefined' && currentPeriod === 'week' ? 'active' : '' %>">This Week</a>
        <a href="/dashboard?period=month" class="filter-tab <%= typeof currentPeriod !== 'undefined' && currentPeriod === 'month' ? 'active' : '' %>">This Month</a>
        <a href="/dashboard?period=year" class="filter-tab <%= typeof currentPeriod !== 'undefined' && currentPeriod === 'year' ? 'active' : '' %>">This Year</a>
    </div>
</div>

<!-- Stats Grid (5 Cards in 1 Row) -->
<div class="stats-grid">
    <!-- 1. Total Sales -->
    <div class="stat-card">
        <div class="stat-icon orange">
            <i class="fas fa-chart-line"></i>
        </div>
        <div class="stat-details">
            <h3>Total Sales</h3>
            <p class="stat-value" id="totalSales">
                <span class="currency-symbol"><%= typeof currencySymbol !== 'undefined' ? currencySymbol : '$' %></span>
                <span class="amount"><%= typeof stats !== 'undefined' && stats.totalSales ? stats.totalSales.toLocaleString() : '0' %></span>
            </p>
            <span class="stat-period"><%= periodText %></span>
        </div>
    </div>
    
    <!-- 2. Total Profit -->
    <div class="stat-card">
        <div class="stat-icon red">
            <i class="fas fa-hand-holding-usd"></i>
        </div>
        <div class="stat-details">
            <h3>Total Profit</h3>
            <p class="stat-value" id="totalProfit">
                <span class="currency-symbol"><%= typeof currencySymbol !== 'undefined' ? currencySymbol : '$' %></span>
                <span class="amount"><%= typeof stats !== 'undefined' && stats.totalProfit ? stats.totalProfit.toLocaleString() : '0' %></span>
            </p>
            <span class="stat-period"><%= periodText %></span>
        </div>
    </div>
    
    <!-- 3. Investment / Cost -->
    <div class="stat-card">
        <div class="stat-icon green">
            <i class="fas fa-coins"></i>
        </div>
        <div class="stat-details">
            <h3>Investment (Cost)</h3>
            <p class="stat-value" id="totalInvestment">
                <span class="currency-symbol"><%= typeof currencySymbol !== 'undefined' ? currencySymbol : '$' %></span>
                <span class="amount"><%= typeof stats !== 'undefined' && stats.totalInvestment ? stats.totalInvestment.toLocaleString() : '0' %></span>
            </p>
            <span class="stat-period"><%= periodText %></span>
        </div>
    </div>
    
    <!-- 4. ROI -->
    <div class="stat-card">
        <div class="stat-icon blue">
            <i class="fas fa-percentage"></i>
        </div>
        <div class="stat-details">
            <h3>ROI</h3>
            <p class="stat-value" id="roi">
                <span class="amount"><%= typeof stats !== 'undefined' && stats.roi ? stats.roi : '0' %></span>
                <span>%</span>
            </p>
            <span class="stat-period">Return on Investment</span>
        </div>
    </div>
    
    <!-- 5. Profit Margin -->
    <div class="stat-card">
        <div class="stat-icon purple">
            <i class="fas fa-chart-pie"></i>
        </div>
        <div class="stat-details">
            <h3>Profit Margin</h3>
            <p class="stat-value" id="profitMargin">
                <span class="amount"><%= typeof stats !== 'undefined' && stats.profitMargin ? stats.profitMargin : '0' %></span>
                <span>%</span>
            </p>
            <span class="stat-period">Margin Percentage</span>
        </div>
    </div>
</div>

<!-- Main Dashboard Content -->
<div class="dashboard-grid">
    <!-- Left Column -->
    <div class="dashboard-main">
        <!-- Recent Orders Table -->
        <div class="card">
            <div class="card-header">
                <h2>Recent Orders (<%= periodText %>)</h2>
                <a href="/reports" class="view-all-link">View All <i class="fas fa-arrow-right"></i></a>
            </div>
            <div class="table-responsive">
                <table class="data-table">
                    <thead>
                        <tr>
                            <th>Product Name</th>
                            <th>Product Number</th>
                            <th>Selling Price</th>
                            <th>Cost Price</th>
                            <th>Profit</th>
                            <th>Status</th>
                            <th>Action</th>
                        </tr>
                    </thead>
                    <tbody id="recentOrdersBody">
                        <% if (typeof recentSales !== 'undefined' && recentSales.length > 0) { %>
                            <% recentSales.forEach(function(sale) { %>
                                <tr>
                                    <td>
                                        <div class="product-cell">
                                            <span class="product-name"><strong><%= sale.productName %></strong></span>
                                        </div>
                                    </td>
                                    <td><%= sale.productNumber || 'N/A' %></td>
                                    <td class="text-success">
                                        <%= typeof currencySymbol !== 'undefined' ? currencySymbol : '$' %><%= sale.sellingPrice.toLocaleString() %>
                                    </td>
                                    <td class="text-muted">
                                        <%= typeof currencySymbol !== 'undefined' ? currencySymbol : '$' %><%= sale.costPrice.toLocaleString() %>
                                    </td>
                                    <td class="<%= sale.profit >= 0 ? 'text-success' : 'text-danger' %>">
                                        <%= typeof currencySymbol !== 'undefined' ? currencySymbol : '$' %><%= sale.profit.toLocaleString() %>
                                    </td>
                                    <td>
                                        <span class="status-badge status-<%= sale.status ? sale.status.toLowerCase() : 'completed' %>">
                                            <%= sale.status || 'Completed' %>
                                        </span>
                                    </td>
                                    <td>
                                        <button class="btn-link" onclick="viewSaleDetail('<%= sale._id %>')">Details</button>
                                    </td>
                                </tr>
                            <% }); %>
                        <% } else { %>
                            <tr>
                                <td colspan="7" class="empty-state">
                                    <i class="fas fa-inbox"></i>
                                    <p>No sales found for <%= periodText.toLowerCase() %>.</p>
                                </td>
                            </tr>
                        <% } %>
                    </tbody>
                </table>
            </div>
        </div>
        
        <!-- Quick Add Sale -->
        <div class="card">
            <div class="card-header">
                <h2>Quick Add Sale</h2>
            </div>
            <form id="quickSaleForm" class="quick-sale-form">
                <div class="form-row">
                    <div class="form-group">
                        <label>Product</label>
                        <select name="productId" id="quickProduct" class="form-select" required>
                            <option value="">Select Product</option>
                            <% if (typeof products !== 'undefined') { %>
                                <% products.forEach(function(product) { %>
                                    <option value="<%= product._id %>" 
                                        data-cost="<%= product.costPrice %>" 
                                        data-sell="<%= product.sellingPrice %>">
                                        <%= product.name %>
                                    </option>
                                <% }); %>
                            <% } %>
                        </select>
                    </div>
                    <div class="form-group">
                        <label>Quantity</label>
                        <input type="number" name="quantity" id="quickQty" value="1" min="1" required>
                    </div>
                    <div class="form-group">
                        <label>Selling Price (per item)</label>
                        <input type="number" name="sellingPrice" id="quickSellingPrice" step="0.01" required placeholder="0.00">
                    </div>
                    <div class="form-group">
                        <label>Sale Type</label>
                        <select name="saleType" class="form-select">
                            <option value="local">Local (In-Store)</option>
                            <option value="online">Online (E-commerce)</option>
                        </select>
                    </div>
                </div>
                <div class="form-row">
                    <div class="form-group">
                        <label>Employee (Optional)</label>
                        <select name="employeeId" class="form-select">
                            <option value="">Self</option>
                            <% if (typeof employees !== 'undefined') { %>
                                <% employees.forEach(function(emp) { %>
                                    <option value="<%= emp._id %>"><%= emp.name %></option>
                                <% }); %>
                            <% } %>
                        </select>
                    </div>
                    <div class="form-group flex-end">
                        <button type="submit" class="btn btn-primary" id="addSaleBtn">
                            <i class="fas fa-plus"></i> Add Sale
                        </button>
                    </div>
                </div>
            </form>
        </div>
    </div>
    
    <!-- Right Column -->
    <div class="dashboard-sidebar-right">
        <!-- Recent Updates -->
        <div class="card">
            <div class="card-header">
                <h2>Recent Updates</h2>
            </div>
            <div class="updates-list">
                <% if (typeof recentUpdates !== 'undefined' && recentUpdates.length > 0) { %>
                    <% recentUpdates.forEach(function(update) { %>
                        <div class="update-item">
                            <div class="update-avatar">
                                <div class="avatar-placeholder small">
                                    <%= update.customerName ? update.customerName.charAt(0).toUpperCase() : 'U' %>
                                </div>
                            </div>
                            <div class="update-content">
                                <p><strong><%= update.customerName %></strong> <%= update.action %></p>
                                <span class="update-time"><%= update.timeAgo %></span>
                            </div>
                        </div>
                    <% }); %>
                <% } else { %>
                    <div class="empty-state small">
                        <p>No recent updates</p>
                    </div>
                <% } %>
            </div>
        </div>
        
        <!-- Sales Analytics Mini -->
        <div class="card">
            <div class="card-header">
                <h2>Sales Analytics</h2>
            </div>
            <div class="analytics-mini">
                <div class="analytics-item">
                    <div class="analytics-icon online">
                        <i class="fas fa-shopping-cart"></i>
                    </div>
                    <div class="analytics-detail">
                        <span class="analytics-label">Online Orders</span>
                        <span class="analytics-value">
                            <%= typeof stats !== 'undefined' ? stats.onlineOrders : '0' %>
                        </span>
                    </div>
                </div>
                <div class="analytics-item">
                    <div class="analytics-icon local">
                        <i class="fas fa-store"></i>
                    </div>
                    <div class="analytics-detail">
                        <span class="analytics-label">Local Sales</span>
                        <span class="analytics-value">
                            <%= typeof stats !== 'undefined' ? stats.localSales : '0' %>
                        </span>
                    </div>
                </div>
            </div>
        </div>
        
        <!-- Last Sold Item -->
        <div class="card">
            <div class="card-header">
                <h2>Last Sold</h2>
            </div>
            <% if (typeof lastSold !== 'undefined' && lastSold) { %>
                <div class="last-sold-item">
                    <h4><%= lastSold.productName %></h4>
                    <div class="last-sold-details">
                        <div class="detail-row">
                            <span>Selling Price:</span>
                            <span class="text-success"><%= currencySymbol %><%= lastSold.sellingPrice.toLocaleString() %></span>
                        </div>
                        <div class="detail-row">
                            <span>Cost Price:</span>
                            <span><%= currencySymbol %><%= lastSold.costPrice.toLocaleString() %></span>
                        </div>
                        <div class="detail-row">
                            <span>Profit:</span>
                            <span class="text-success font-bold"><%= currencySymbol %><%= lastSold.profit.toLocaleString() %></span>
                        </div>
                        <div class="detail-row">
                            <span>Sold:</span>
                            <span><%= lastSold.timeAgo %></span>
                        </div>
                    </div>
                </div>
            <% } else { %>
                <div class="empty-state small">
                    <p>No sales yet</p>
                </div>
            <% } %>
        </div>
    </div>
</div>

<!-- Sale Detail Modal -->
<div class="modal" id="saleDetailModal">
    <div class="modal-content">
        <div class="modal-header">
            <h2>Sale Details</h2>
            <button class="modal-close" onclick="closeSaleModal()">&times;</button>
        </div>
        <div class="modal-body" id="saleDetailBody">
            <!-- Dynamic content loaded via JS -->
        </div>
    </div>
</div>

<script>
    document.addEventListener('DOMContentLoaded', function() {
        // Quick Product Selection - Auto Fill Price
        const quickProd = document.getElementById('quickProduct');
        if (quickProd) {
            quickProd.addEventListener('change', function() {
                const selected = this.options[this.selectedIndex];
                const sellPrice = selected.getAttribute('data-sell');
                if (sellPrice) {
                    document.getElementById('quickSellingPrice').value = sellPrice;
                }
            });
        }
        
        // Quick Sale Form Submit
        const quickForm = document.getElementById('quickSaleForm');
        if (quickForm) {
            quickForm.addEventListener('submit', async function(e) {
                e.preventDefault();
                const btn = document.getElementById('addSaleBtn');
                btn.disabled = true;
                btn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Adding...';

                const formData = new FormData(this);
                const data = Object.fromEntries(formData);
                
                try {
                    const res = await fetch('/api/sales', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify(data)
                    });
                    const result = await res.json();
                    if (result.success) {
                        showToast('Sale added successfully!', 'success');
                        setTimeout(() => location.reload(), 600);
                    } else {
                        showToast(result.message || 'Error adding sale', 'error');
                        btn.disabled = false;
                        btn.innerHTML = '<i class="fas fa-plus"></i> Add Sale';
                    }
                } catch(err) {
                    showToast('Failed to add sale', 'error');
                    btn.disabled = false;
                    btn.innerHTML = '<i class="fas fa-plus"></i> Add Sale';
                }
            });
        }
    });
    
    function viewSaleDetail(saleId) {
        fetch('/api/sales/' + saleId)
            .then(res => res.json())
            .then(data => {
                if (data.success) {
                    const sale = data.sale;
                    document.getElementById('saleDetailBody').innerHTML = `
                        <div class="sale-detail-grid">
                            <div class="detail-row"><span>Product:</span><strong>${sale.productName}</strong></div>
                            <div class="detail-row"><span>Quantity:</span><strong>${sale.quantity}</strong></div>
                            <div class="detail-row"><span>Cost Price:</span><strong>${sale.costPrice}</strong></div>
                            <div class="detail-row"><span>Selling Price:</span><strong>${sale.sellingPrice}</strong></div>
                            <div class="detail-row"><span>Profit:</span><strong class="text-success">${sale.profit}</strong></div>
                            <div class="detail-row"><span>Sale Type:</span><strong>${sale.saleType}</strong></div>
                            <div class="detail-row"><span>Date:</span><strong>${new Date(sale.createdAt).toLocaleString()}</strong></div>
                            <div class="detail-row"><span>Employee:</span><strong>${sale.employeeName || 'Self'}</strong></div>
                        </div>
                    `;
                    document.getElementById('saleDetailModal').classList.add('active');
                }
            });
    }
    
    function closeSaleModal() {
        document.getElementById('saleDetailModal').classList.remove('active');
    }
</script>