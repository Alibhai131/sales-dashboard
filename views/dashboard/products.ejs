<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Products - Sales Dashboard</title>
    <link rel="stylesheet" href="/css/style.css">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" rel="stylesheet">
    <style>
        .form-card {
            background: var(--color-white);
            padding: 1.5rem;
            border-radius: var(--card-border-radius);
            box-shadow: var(--box-shadow);
            margin-bottom: 2rem;
        }
        .form-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
            gap: 1rem;
            margin-top: 1rem;
        }
        .form-group label { display: block; margin-bottom: 0.4rem; font-weight: 500; }
        .form-group input, .form-group select {
            width: 100%;
            padding: 0.7rem;
            border-radius: var(--border-radius-1);
            background: var(--color-light);
            color: var(--color-dark);
            border: none;
        }
        .btn-submit {
            background: var(--color-primary);
            color: white;
            padding: 0.8rem 1.5rem;
            border-radius: var(--border-radius-1);
            cursor: pointer;
            margin-top: 1rem;
            font-weight: 600;
        }
    </style>
</head>
<body>
    <div class="container">
        <!-- SIDEBAR -->
        <aside id="aside-bar">
            <div class="top">
                <div class="logo">
                    <i class="fa-solid fa-chart-line primary" style="font-size: 1.6rem;"></i>
                    <h2>SALES<span class="danger">PRO</span></h2>
                </div>
            </div>
            <div class="sidebar">
                <a href="/dashboard"><i class="fa-solid fa-grid-2"></i><h3>Dashboard</h3></a>
                <a href="/employees"><i class="fa-solid fa-users"></i><h3>Employees (10)</h3></a>
                <a href="/products" class="active"><i class="fa-solid fa-box-open"></i><h3>Products</h3></a>
                <a href="/reports"><i class="fa-solid fa-file-invoice"></i><h3>Reports</h3></a>
                <a href="/auth/logout"><i class="fa-solid fa-right-from-bracket"></i><h3>Logout</h3></a>
            </div>
        </aside>

        <!-- MAIN CONTENT -->
        <main>
            <h1>Product Management</h1>

            <!-- ADD PRODUCT FORM -->
            <div class="form-card">
                <h2><i class="fa-solid fa-plus-circle"></i> Add New Product</h2>
                <form action="/products/add" method="POST">
                    <div class="form-grid">
                        <div class="form-group">
                            <label>Product Name</label>
                            <input type="text" name="productName" required placeholder="e.g. Wireless Mouse">
                        </div>
                        <div class="form-group">
                            <label>Product Code / SKU</label>
                            <input type="text" name="productNumber" required placeholder="e.g. PRD-102">
                        </div>
                        <div class="form-group">
                            <label>Cost Price (Investment)</label>
                            <input type="number" step="0.01" name="costPrice" required placeholder="0.00">
                        </div>
                        <div class="form-group">
                            <label>Selling Price</label>
                            <input type="number" step="0.01" name="sellingPrice" required placeholder="0.00">
                        </div>
                        <div class="form-group">
                            <label>Stock Quantity</label>
                            <input type="number" name="stock" required placeholder="10">
                        </div>
                    </div>
                    <button type="submit" class="btn-submit">Add Product</button>
                </form>
            </div>

            <!-- PRODUCT LIST -->
            <div class="recent-orders">
                <h2>Product Inventory</h2>
                <table>
                    <thead>
                        <tr>
                            <th>Name</th>
                            <th>Code</th>
                            <th>Cost Price</th>
                            <th>Selling Price</th>
                            <th>Stock</th>
                            <th>Status</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% if(products && products.length > 0) { %>
                            <% products.forEach(p => { %>
                                <tr>
                                    <td><%= p.productName %></td>
                                    <td><%= p.productNumber %></td>
                                    <td><%= user.currency %> <%= p.costPrice %></td>
                                    <td><%= user.currency %> <%= p.sellingPrice %></td>
                                    <td><%= p.stock %></td>
                                    <td class="<%= p.stock > 0 ? 'success' : 'danger' %>"><%= p.status %></td>
                                </tr>
                            <% }) %>
                        <% } else { %>
                            <tr><td colspan="6">No products added yet. Use the form above to add products.</td></tr>
                        <% } %>
                    </tbody>
                </table>
            </div>
        </main>
    </div>
</body>
</html>