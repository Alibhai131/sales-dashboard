<% 
    var activePage = 'reports'; 
    var pageTitle = 'Reports';
    var title = 'Reports - Sales Dashboard';
%>

<div class="page-header-row">
    <div>
        <p class="page-description">View all your sales history and download detailed reports</p>
    </div>
    <div class="header-actions">
        <button class="btn btn-outline" id="downloadPDF">
            <i class="fas fa-file-pdf"></i> Download PDF
        </button>
        <button class="btn btn-outline" id="downloadCSV">
            <i class="fas fa-file-csv"></i> Download CSV
        </button>
    </div>
</div>

<!-- Filters -->
<div class="card">
    <div class="report-filters">
        <div class="form-group">
            <label>Date From</label>
            <input type="date" id="dateFrom" class="form-input">
        </div>
        <div class="form-group">
            <label>Date To</label>
            <input type="date" id="dateTo" class="form-input" value="<%= new Date().toISOString().split('T')[0] %>">
        </div>
        <div class="form-group">
            <label>Sale Type</label>
            <select id="typeFilter" class="form-select">
                <option value="">All</option>
                <option value="local">Local</option>
                <option value="online">Online</option>
            </select>
        </div>
        <div class="form-group">
            <label>Employee</label>
            <select id="empFilter" class="form-select">
                <option value="">All</option>
                <% if (typeof employees !== 'undefined') { %>
                    <% employees.forEach(function(emp) { %>
                        <option value="<%= emp._id %>"><%= emp.name %></option>
                    <% }); %>
                <% } %>
            </select>
        </div>
        <div class="form-group flex-end">
            <button class="btn btn-primary" id="applyFilters">
                <i class="fas fa-filter"></i> Apply
            </button>
        </div>
    </div>
</div>

<!-- Summary Row -->
<div class="stats-grid four-col">
    <div class="stat-card compact">
        <h3>Total Sales</h3>
        <p class="stat-value" id="reportTotalSales">
            <span class="currency-symbol"><%= typeof currencySymbol !== 'undefined' ? currencySymbol : '$' %></span>
            <span class="amount"><%= typeof reportStats !== 'undefined' ? reportStats.totalSales.toLocaleString() : '0' %></span>
        </p>
    </div>
    <div class="stat-card compact">
        <h3>Total Profit</h3>
        <p class="stat-value text-success" id="reportTotalProfit">
            <span class="currency-symbol"><%= typeof currencySymbol !== 'undefined' ? currencySymbol : '$' %></span>
            <span class="amount"><%= typeof reportStats !== 'undefined' ? reportStats.totalProfit.toLocaleString() : '0' %></span>
        </p>
    </div>
    <div class="stat-card compact">
        <h3>Total Investment</h3>
        <p class="stat-value" id="reportTotalCost">
            <span class="currency-symbol"><%= typeof currencySymbol !== 'undefined' ? currencySymbol : '$' %></span>
            <span class="amount"><%= typeof reportStats !== 'undefined' ? reportStats.totalCost.toLocaleString() : '0' %></span>
        </p>
    </div>
    <div class="stat-card compact">
        <h3>Total Orders</h3>
        <p class="stat-value"><span class="amount"><%= typeof reportStats !== 'undefined' ? reportStats.totalOrders : '0' %></span></p>
    </div>
</div>

<!-- Sales Table -->
<div class="card">
    <div class="card-header">
        <h2>Sales History</h2>
        <span class="record-count" id="recordCount">
            <%= typeof sales !== 'undefined' ? sales.length : 0 %> records
        </span>
    </div>
    <div class="table-responsive">
        <table class="data-table" id="salesTable">
            <thead>
                <tr>
                    <th>Date</th>
                    <th>Product</th>
                    <th>Qty</th>
                    <th>Cost Price</th>
                    <th>Selling Price</th>
                    <th>Profit</th>
                    <th>ROI</th>
                    <th>Type</th>
                    <th>Employee</th>
                    <th>Status</th>
                </tr>
            </thead>
            <tbody id="salesTableBody">
                <% if (typeof sales !== 'undefined' && sales.length > 0) { %>
                    <% sales.forEach(function(sale) { %>
                        <tr>
                            <td><%= new Date(sale.createdAt).toLocaleDateString() %></td>
                            <td><strong><%= sale.productName %></strong></td>
                            <td><%= sale.quantity %></td>
                            <td><%= currencySymbol %><%= sale.costPrice.toLocaleString() %></td>
                            <td class="text-success"><%= currencySymbol %><%= sale.sellingPrice.toLocaleString() %></td>
                            <td class="<%= sale.profit >= 0 ? 'text-success' : 'text-danger' %>">
                                <%= currencySymbol %><%= sale.profit.toLocaleString() %>
                            </td>
                            <td><%= sale.costPrice > 0 ? ((sale.profit / sale.costPrice) * 100).toFixed(1) : '0' %>%</td>
                            <td>
                                <span class="type-badge type-<%= sale.saleType %>">
                                    <%= sale.saleType === 'online' ? '🌐 Online' : '🏪 Local' %>
                                </span>
                            </td>
                            <td><%= sale.employeeName || 'Self' %></td>
                            <td>
                                <span class="status-badge status-<%= sale.status.toLowerCase() %>">
                                    <%= sale.status %>
                                </span>
                            </td>
                        </tr>
                    <% }); %>
                <% } else { %>
                    <tr>
                        <td colspan="10" class="empty-state">
                            <i class="fas fa-inbox"></i>
                            <p>No sales records found</p>
                        </td>
                    </tr>
                <% } %>
            </tbody>
        </table>
    </div>
    
    <!-- Pagination -->
    <% if (typeof totalPages !== 'undefined' && totalPages > 1) { %>
        <div class="pagination">
            <% for (let i = 1; i <= totalPages; i++) { %>
                <a href="?page=<%= i %>" class="page-btn <%= typeof currentPage !== 'undefined' && currentPage === i ? 'active' : '' %>"><%= i %></a>
            <% } %>
        </div>
    <% } %>
</div>

<script>
    // Apply Filters
    document.getElementById('applyFilters').addEventListener('click', function() {
        const params = new URLSearchParams({
            dateFrom: document.getElementById('dateFrom').value,
            dateTo: document.getElementById('dateTo').value,
            type: document.getElementById('typeFilter').value,
            employee: document.getElementById('empFilter').value
        });
        window.location.href = `/reports?${params.toString()}`;
    });
    
    // Download PDF
    document.getElementById('downloadPDF').addEventListener('click', function() {
        const params = new URLSearchParams(window.location.search);
        window.open(`/reports/download/pdf?${params.toString()}`, '_blank');
    });
    
    // Download CSV
    document.getElementById('downloadCSV').addEventListener('click', function() {
        const params = new URLSearchParams(window.location.search);
        window.open(`/reports/download/csv?${params.toString()}`, '_blank');
    });
</script>