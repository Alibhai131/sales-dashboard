<% 
    var activePage = 'analytics'; 
    var pageTitle = 'Analytics';
    var title = 'Analytics - Sales Dashboard';
%>

<!-- Analytics Filters -->
<div class="analytics-header">
    <div class="filter-tabs">
        <button class="filter-tab active" data-period="week">Week</button>
        <button class="filter-tab" data-period="month">Month</button>
        <button class="filter-tab" data-period="year">Year</button>
    </div>
    <div class="analytics-actions">
        <button class="btn btn-outline" id="downloadReport">
            <i class="fas fa-download"></i> Download PDF
        </button>
    </div>
</div>

<!-- Summary Cards -->
<div class="stats-grid four-col">
    <div class="stat-card compact">
        <div class="stat-icon blue"><i class="fas fa-receipt"></i></div>
        <div>
            <h3>Total Revenue</h3>
            <p class="stat-value" id="analyticsRevenue">
                <span class="currency-symbol"><%= typeof currencySymbol !== 'undefined' ? currencySymbol : '$' %></span>
                <span class="amount"><%= typeof analytics !== 'undefined' ? analytics.totalRevenue.toLocaleString() : '0' %></span>
            </p>
        </div>
    </div>
    <div class="stat-card compact">
        <div class="stat-icon green"><i class="fas fa-arrow-up"></i></div>
        <div>
            <h3>Net Profit</h3>
            <p class="stat-value" id="analyticsProfit">
                <span class="currency-symbol"><%= typeof currencySymbol !== 'undefined' ? currencySymbol : '$' %></span>
                <span class="amount"><%= typeof analytics !== 'undefined' ? analytics.netProfit.toLocaleString() : '0' %></span>
            </p>
        </div>
    </div>
    <div class="stat-card compact">
        <div class="stat-icon orange"><i class="fas fa-shopping-bag"></i></div>
        <div>
            <h3>Total Orders</h3>
            <p class="stat-value"><span class="amount"><%= typeof analytics !== 'undefined' ? analytics.totalOrders : '0' %></span></p>
        </div>
    </div>
    <div class="stat-card compact">
        <div class="stat-icon purple"><i class="fas fa-percentage"></i></div>
        <div>
            <h3>Avg Profit Margin</h3>
            <p class="stat-value"><span class="amount"><%= typeof analytics !== 'undefined' ? analytics.avgProfitMargin : '0' %></span>%</p>
        </div>
    </div>
</div>

<!-- Hidden Data Container for Charts (Fixes VS Code JS Linter Errors) -->
<div id="chartDataContainer" class="hidden"
    data-labels='<%- JSON.stringify(typeof chartLabels !== "undefined" ? chartLabels : ["Mon","Tue","Wed","Thu","Fri","Sat","Sun"]) %>'
    data-sales='<%- JSON.stringify(typeof salesData !== "undefined" ? salesData : [0,0,0,0,0,0,0]) %>'
    data-profit='<%- JSON.stringify(typeof profitData !== "undefined" ? profitData : [0,0,0,0,0,0,0]) %>'
    data-daily='<%- JSON.stringify(typeof dailySalesData !== "undefined" ? dailySalesData : [0,0,0,0,0,0,0]) %>'
    data-online="<%= typeof analytics !== 'undefined' ? analytics.onlineRevenue : 0 %>"
    data-local="<%= typeof analytics !== 'undefined' ? analytics.localRevenue : 0 %>">
</div>

<!-- Charts Row -->
<div class="charts-grid">
    <!-- Sales & Profit Line Chart -->
    <div class="card chart-card">
        <div class="card-header">
            <h2>Sales vs Profit</h2>
        </div>
        <div class="chart-container">
            <canvas id="salesProfitChart"></canvas>
        </div>
    </div>
    
    <!-- Revenue Breakdown Pie -->
    <div class="card chart-card">
        <div class="card-header">
            <h2>Revenue Breakdown</h2>
        </div>
        <div class="chart-container">
            <canvas id="revenueBreakdownChart"></canvas>
        </div>
    </div>
</div>

<!-- More Charts -->
<div class="charts-grid">
    <!-- Daily Sales Bar Chart -->
    <div class="card chart-card">
        <div class="card-header">
            <h2>Daily Sales</h2>
        </div>
        <div class="chart-container">
            <canvas id="dailySalesChart"></canvas>
        </div>
    </div>
    
    <!-- Top Products -->
    <div class="card">
        <div class="card-header">
            <h2>Top Products</h2>
        </div>
        <div class="top-products-list">
            <% if (typeof topProducts !== 'undefined' && topProducts.length > 0) { %>
                <% topProducts.forEach(function(product, index) { %>
                    <div class="top-product-item">
                        <span class="rank">#<%= index + 1 %></span>
                        <div class="product-info">
                            <h4><%= product.name %></h4>
                            <span class="product-sales"><%= product.totalSold %> sold</span>
                        </div>
                        <span class="product-revenue text-success">
                            <%= typeof currencySymbol !== 'undefined' ? currencySymbol : '$' %><%= product.revenue.toLocaleString() %>
                        </span>
                    </div>
                <% }); %>
            <% } else { %>
                <div class="empty-state small"><p>No product data yet</p></div>
            <% } %>
        </div>
    </div>
</div>

<!-- Employee Performance -->
<div class="card">
    <div class="card-header">
        <h2>Employee Performance</h2>
    </div>
    <div class="table-responsive">
        <table class="data-table">
            <thead>
                <tr>
                    <th>Employee</th>
                    <th>Total Sales</th>
                    <th>Revenue Generated</th>
                    <th>Profit Generated</th>
                    <th>Avg Sale Value</th>
                </tr>
            </thead>
            <tbody>
                <% if (typeof employeePerformance !== 'undefined' && employeePerformance.length > 0) { %>
                    <% employeePerformance.forEach(function(emp) { %>
                        <tr>
                            <td><strong><%= emp.name %></strong></td>
                            <td><%= emp.totalSales %></td>
                            <td class="text-success"><%= typeof currencySymbol !== 'undefined' ? currencySymbol : '$' %><%= emp.revenue.toLocaleString() %></td>
                            <td class="text-success"><%= typeof currencySymbol !== 'undefined' ? currencySymbol : '$' %><%= emp.profit.toLocaleString() %></td>
                            <td><%= typeof currencySymbol !== 'undefined' ? currencySymbol : '$' %><%= emp.avgSaleValue.toLocaleString() %></td>
                        </tr>
                    <% }); %>
                <% } else { %>
                    <tr><td colspan="5" class="empty-state">No employee data</td></tr>
                <% } %>
            </tbody>
        </table>
    </div>
</div>

<script>
    document.addEventListener('DOMContentLoaded', function() {
        // Read chart data cleanly from DOM
        const container = document.getElementById('chartDataContainer');
        const chartLabels = JSON.parse(container.dataset.labels);
        const salesData = JSON.parse(container.dataset.sales);
        const profitData = JSON.parse(container.dataset.profit);
        const dailySalesData = JSON.parse(container.dataset.daily);
        const onlineRevenue = parseFloat(container.dataset.online);
        const localRevenue = parseFloat(container.dataset.local);

        // Sales vs Profit Line Chart
        const salesProfitCtx = document.getElementById('salesProfitChart').getContext('2d');
        new Chart(salesProfitCtx, {
            type: 'line',
            data: {
                labels: chartLabels,
                datasets: [{
                    label: 'Sales',
                    data: salesData,
                    borderColor: '#2563eb',
                    backgroundColor: 'rgba(37,99,235,0.1)',
                    fill: true,
                    tension: 0.4
                }, {
                    label: 'Profit',
                    data: profitData,
                    borderColor: '#10b981',
                    backgroundColor: 'rgba(16,185,129,0.1)',
                    fill: true,
                    tension: 0.4
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: { legend: { position: 'top' } },
                scales: { y: { beginAtZero: true } }
            }
        });

        // Revenue Breakdown Pie
        const revenueCtx = document.getElementById('revenueBreakdownChart').getContext('2d');
        new Chart(revenueCtx, {
            type: 'doughnut',
            data: {
                labels: ['Online Sales', 'Local Sales'],
                datasets: [{
                    data: [onlineRevenue, localRevenue],
                    backgroundColor: ['#2563eb', '#10b981'],
                    borderWidth: 0
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: { legend: { position: 'bottom' } }
            }
        });

        // Daily Sales Bar Chart
        const dailyCtx = document.getElementById('dailySalesChart').getContext('2d');
        new Chart(dailyCtx, {
            type: 'bar',
            data: {
                labels: chartLabels,
                datasets: [{
                    label: 'Sales',
                    data: dailySalesData,
                    backgroundColor: '#2563eb',
                    borderRadius: 6
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: { legend: { display: false } },
                scales: { y: { beginAtZero: true } }
            }
        });

        // Download PDF
        const downloadBtn = document.getElementById('downloadReport');
        if (downloadBtn) {
            downloadBtn.addEventListener('click', function() {
                window.open('/reports/download/pdf?type=analytics', '_blank');
            });
        }
    });
</script>